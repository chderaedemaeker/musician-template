{% assign lang = page.lang %}

<div class="concerts-page">

  <header class="page-header">
    <p class="label">{{ languages[lang].site_subtitle }}</p>
    <h1>{{ languages[lang].concerts_title }}</h1>
  </header>

  <section class="concert-list-section">
    <h2>{{ languages[lang].upcoming_concerts }}</h2>
    <ul class="concert-list" id="upcoming-concerts"></ul>
  </section>

  <section class="concert-list-section">
    <h2>{{ languages[lang].archive }}</h2>
    <ul class="concert-list" id="archive-concerts"></ul>
    <div class="mt-md">
      <button type="button" class="btn" id="archive-more" hidden>{{ languages[lang].show_earlier }}</button>
    </div>
  </section>

</div>

{% include "concert-modal.liquid" %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  var concerts = {% concertsJson collections.concerts %};
  var lang = '{{ lang }}';
  var detailsLabel = '{{ languages[lang].details }}';
  var ticketsLabel = '{{ languages[lang].tickets }}';

  /* A concert counts as upcoming until its last day has fully passed:
     end date for multi-day, end of month for month-only, end of day otherwise. */
  function endOf(c) {
    var d = new Date(c.dateEnd || c.date);
    if (c.monthOnly && !c.dateEnd) return new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59);
  }

  function dateStr(c, opts) {
    var d = new Date(c.date);
    if (c.monthOnly) return d.toLocaleDateString(lang, { month: 'long', year: 'numeric' });
    if (c.dateEnd) {
      var e = new Date(c.dateEnd);
      if (d.getFullYear() === e.getFullYear() && d.getMonth() === e.getMonth()) {
        return d.getDate() + ' – ' + e.toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' });
      }
      var startOpts = d.getFullYear() === e.getFullYear() ? { day: 'numeric', month: 'long' } : opts;
      return d.toLocaleDateString(lang, startOpts) + ' – ' + e.toLocaleDateString(lang, opts);
    }
    return d.toLocaleDateString(lang, opts);
  }
  window.concertDateStr = dateStr; /* reused by the modal */

  var now = new Date();
  var upcoming = concerts.filter(function(c) { return endOf(c) >= now; })
    .sort(function(a, b) { return new Date(a.date) - new Date(b.date); });
  var archive = concerts.filter(function(c) { return endOf(c) < now; })
    .sort(function(a, b) { return new Date(b.date) - new Date(a.date); });

  function rowHtml(c, isArchive) {
    var dateOpts = isArchive
      ? { day: 'numeric', month: 'long', year: 'numeric' }
      : { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
    var d = dateStr(c, dateOpts);
    var aside = '';
    if (c.composers) aside += '<p class="concert-row-detail">' + c.composers + '</p>';
    if (c.collaborators) aside += '<p class="concert-row-detail">' + c.collaborators + '</p>';
    if (c.ticket && !isArchive) {
      aside += '<a class="concert-row-ticket" href="' + c.ticket + '" target="_blank" rel="noopener">' +
        ticketsLabel + ' <span aria-hidden="true">&#8599;</span></a>';
    }
    aside += '<span class="concert-row-more">' + detailsLabel + '</span>';
    return '<li class="concert-row' + (isArchive ? ' concert-row--archive' : '') + '">' +
      '<p class="concert-row-date">' + d + '</p>' +
      '<div class="concert-row-main">' +
        '<h3><button type="button" class="concert-row-trigger" data-ci="' + concerts.indexOf(c) + '">' + c.title + '</button></h3>' +
        (c.place ? '<p class="concert-row-place">' + c.place + '</p>' : '') +
      '</div>' +
      '<div class="concert-row-aside">' + aside + '</div>' +
    '</li>';
  }

  function bindRows(container) {
    container.querySelectorAll('.concert-row-trigger:not([data-bound])').forEach(function(btn) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', function() {
        openConcertModal(concerts[parseInt(this.dataset.ci, 10)]);
      });
    });
  }

  var upcomingEl = document.getElementById('upcoming-concerts');
  if (upcoming.length === 0) {
    upcomingEl.innerHTML = '<li><p class="empty-note">{{ languages[lang].no_upcoming }}</p></li>';
  } else {
    upcomingEl.innerHTML = upcoming.map(function(c) { return rowHtml(c, false); }).join('');
    bindRows(upcomingEl);
  }

  /* Archive: grouped by year, recent two years shown, the rest behind a button */
  var archiveEl = document.getElementById('archive-concerts');
  var moreBtn = document.getElementById('archive-more');

  function archiveHtml(list) {
    var html = '';
    var lastYear = null;
    list.forEach(function(c) {
      var year = new Date(c.date).getFullYear();
      if (year !== lastYear) {
        html += '<li class="concert-year-heading">' + year + '</li>';
        lastYear = year;
      }
      html += rowHtml(c, true);
    });
    return html;
  }

  var cutoffYear = now.getFullYear() - 1;
  var recent = archive.filter(function(c) { return new Date(c.date).getFullYear() >= cutoffYear; });
  var earlier = archive.filter(function(c) { return new Date(c.date).getFullYear() < cutoffYear; });

  archiveEl.innerHTML = archiveHtml(recent);
  bindRows(archiveEl);

  if (earlier.length > 0) {
    moreBtn.hidden = false;
    moreBtn.addEventListener('click', function() {
      archiveEl.insertAdjacentHTML('beforeend', archiveHtml(earlier));
      bindRows(archiveEl);
      moreBtn.hidden = true;
    });
  }
});
</script>
