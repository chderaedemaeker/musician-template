<script>
  (function () {
    function loadFull(img) {
      /* Start loading the full image over the dominant-colour tile */
      var src = img.dataset.src;
      var started = (window.performance && performance.now) ? performance.now() : 0;
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.removeAttribute('data-src');
      img.removeAttribute('data-srcset');
      img.src = src;

      /* Fade in only once the frame is fully decoded — no half-painted pop.
         The colour tile always shows for a beat first, even when the image
         arrives instantly from cache, so the reveal is always a soft fade. */
      var MIN_COLOUR_MS = 350;
      function onLoaded() {
        var elapsed = started ? (performance.now() - started) : 0;
        var wait = Math.max(0, MIN_COLOUR_MS - elapsed);
        setTimeout(function () {
          /* two frames so the browser commits the decoded frame before the fade starts */
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { img.classList.add('prog-loaded'); });
          });
        }, wait);
      }
      function fallback() {
        if (img.complete && img.naturalWidth) onLoaded();
        else img.addEventListener('load', onLoaded, { once: true });
      }
      if (img.decode) {
        img.decode().then(onLoaded, fallback);
      } else {
        fallback();
      }
    }

    function init() {
      var imgs = document.querySelectorAll('img.prog-img[data-src]');
      if (!imgs.length) return;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            /* target may be the wrapper div or the img itself */
            var img = e.target.tagName === 'IMG'
              ? e.target
              : e.target.querySelector('img.prog-img[data-src]');
            if (img) loadFull(img);
            io.unobserve(e.target);
          });
        }, { rootMargin: '600px' });
        imgs.forEach(function (img) {
          /* Observe the wrapper (no transform applied) instead of the img.
             iOS Safari IntersectionObserver misfires on transformed elements
             inside overflow:hidden containers. */
          var target = img.closest('.prog-img-wrap') || img;
          io.observe(target);
        });
      } else {
        imgs.forEach(loadFull);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
