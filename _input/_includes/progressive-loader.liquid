<script>
  (function () {
    function loadFull(img) {
      /* Step 1: fade in the blurry placeholder (white → blurry) */
      img.classList.add('prog-reveal');

      /* Step 2: start loading the full image */
      var src = img.dataset.src;
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.removeAttribute('data-src');
      img.removeAttribute('data-srcset');
      img.src = src;

      /* Step 3: when full image is decoded, blur transitions to crisp */
      function onLoaded() { img.classList.add('prog-loaded'); }
      if (img.complete && img.naturalWidth) {
        onLoaded();
      } else {
        img.addEventListener('load', onLoaded, { once: true });
      }
    }

    function init() {
      var imgs = document.querySelectorAll('img.prog-img[data-src]');
      if (!imgs.length) return;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            /* target may be the wrapper div or the img itself */
            var img = e.target.tagName === 'IMG'
              ? e.target
              : e.target.querySelector('img.prog-img[data-src]');
            if (img) loadFull(img);
            io.unobserve(e.target);
          });
        }, { rootMargin: '200px' });
        imgs.forEach(function (img) {
          /* Observe the wrapper (no transform applied) instead of the img.
             iOS Safari IntersectionObserver misfires on transformed elements
             inside overflow:hidden containers. */
          var target = img.closest('.prog-img-wrap') || img;
          io.observe(target);
        });
      } else {
        imgs.forEach(loadFull);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
