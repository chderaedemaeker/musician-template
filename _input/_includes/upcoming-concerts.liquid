{% assign lang = page.lang %}
<section id="upcoming-section" class="section container-prose reveal">

  <div class="home-section-header">
    <h2 class="label">{{ languages[lang].upcoming_concerts }}</h2>
  </div>

  <ul class="upcoming-list"></ul>

  <div class="home-more">
    <a class="btn" href="/{{ lang }}/concerts/">{{ languages[lang].see_all_concerts }} <span aria-hidden="true">&#8594;</span></a>
  </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var concerts = {% concertsJson collections.concerts %};
  var lang = '{{ lang }}';

  function endOf(c) {
    var d = new Date(c.dateEnd || c.date);
    if (c.monthOnly && !c.dateEnd) return new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59);
  }

  function dateStr(c) {
    var opts = { year: 'numeric', month: 'long', day: 'numeric' };
    var d = new Date(c.date);
    if (c.monthOnly) return d.toLocaleDateString(lang, { month: 'long', year: 'numeric' });
    if (c.dateEnd) {
      var e = new Date(c.dateEnd);
      if (d.getFullYear() === e.getFullYear() && d.getMonth() === e.getMonth()) {
        return d.getDate() + ' – ' + e.toLocaleDateString(lang, opts);
      }
      var startOpts = d.getFullYear() === e.getFullYear() ? { day: 'numeric', month: 'long' } : opts;
      return d.toLocaleDateString(lang, startOpts) + ' – ' + e.toLocaleDateString(lang, opts);
    }
    return d.toLocaleDateString(lang, opts);
  }

  var now = new Date();
  var upcoming = concerts
    .filter(function(c) { return endOf(c) >= now; })
    .sort(function(a, b) { return new Date(a.date) - new Date(b.date); })
    .slice(0, 3);

  var list = document.querySelector('.upcoming-list');
  if (upcoming.length === 0) {
    document.getElementById('upcoming-section').style.display = 'none';
  } else {
    list.innerHTML = upcoming.map(function(c) {
      return '<li>' +
        '<a class="upcoming-item" href="' + c.link + '">' +
          '<span class="upcoming-item-date">' + dateStr(c) + '</span>' +
          '<span class="upcoming-item-title">' + c.title + '</span>' +
          (c.place ? '<span class="upcoming-item-place">' + c.place + '</span>' : '') +
        '</a>' +
      '</li>';
    }).join('');
  }
});
</script>
