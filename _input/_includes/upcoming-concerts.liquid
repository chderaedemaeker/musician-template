{% assign lang = page.lang %}
<div id="upcoming-section" style="max-width: var(--content-width); margin: 0 auto; padding: var(--space-xl) var(--space-md);">

  <h2 class="section-title" style="margin-bottom: var(--space-lg);">{{ languages[lang].upcoming_concerts }}</h2>

  <div class="upcoming-concerts-list"></div>

  <div style="margin-top: var(--space-lg);">
    <a class="btn" href="/{{ lang }}/concerts/">{{ languages[lang].see_all_concerts }}</a>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var concerts = {% concertsJson collections.concerts %};
  var lang = '{{ lang }}';

  function endOf(c) {
    var d = new Date(c.dateEnd || c.date);
    if (c.monthOnly && !c.dateEnd) return new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59);
  }

  function dateStr(c) {
    var opts = { year: 'numeric', month: 'long', day: 'numeric' };
    var d = new Date(c.date);
    if (c.monthOnly) return d.toLocaleDateString(lang, { month: 'long', year: 'numeric' });
    if (c.dateEnd) {
      var e = new Date(c.dateEnd);
      if (d.getFullYear() === e.getFullYear() && d.getMonth() === e.getMonth()) {
        return d.getDate() + ' – ' + e.toLocaleDateString(lang, opts);
      }
      var startOpts = d.getFullYear() === e.getFullYear() ? { day: 'numeric', month: 'long' } : opts;
      return d.toLocaleDateString(lang, startOpts) + ' – ' + e.toLocaleDateString(lang, opts);
    }
    return d.toLocaleDateString(lang, opts);
  }

  var now = new Date();
  var upcoming = concerts
    .filter(function(c) { return endOf(c) >= now; })
    .sort(function(a, b) { return new Date(a.date) - new Date(b.date); })
    .slice(0, 3);

  var list = document.querySelector('.upcoming-concerts-list');
  if (upcoming.length === 0) {
    document.getElementById('upcoming-section').style.display = 'none';
  } else {
    upcoming.forEach(function(c) {
      list.innerHTML += '<a href="' + c.link + '" style="display: block; padding: var(--space-sm) 0; border-bottom: 1px solid var(--warm-grey); text-decoration: none;"><span style="font-size: 0.75em; color: var(--dark-grey); font-family: var(--font-sans);">' + dateStr(c) + '</span><br><span style="font-weight: 300;">' + c.title + '</span>' + (c.place ? '<br><span style="font-size: 0.8em; color: var(--dark-grey); font-style: italic;">' + c.place + '</span>' : '') + '</a>';
    });
  }
});
</script>
