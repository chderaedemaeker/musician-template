<ul class="upcoming-list"></ul>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var concerts = {% concertsJson collections.concerts %};
  var lang = '{{ page.lang }}';
  concerts.forEach(function (c) {
    if (c.link && lang !== 'en') c.link = c.link.replace(/^\/en\//, '/' + lang + '/');
  });

  function endOf(c) {
    var d = new Date(c.dateEnd || c.date);
    if (c.monthOnly && !c.dateEnd) return new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59);
  }

  function dmy(x) { return x.getDate() + ' ' + x.toLocaleDateString(lang, { month: 'long', year: 'numeric' }); }
  function dm(x) { return x.getDate() + ' ' + x.toLocaleDateString(lang, { month: 'long' }); }
  function dateStr(c) {
    var d = new Date(c.date);
    if (c.monthOnly) return d.toLocaleDateString(lang, { month: 'long', year: 'numeric' });
    if (c.dateEnd) {
      var e = new Date(c.dateEnd);
      if (d.getFullYear() === e.getFullYear() && d.getMonth() === e.getMonth()) return d.getDate() + ' – ' + dmy(e);
      if (d.getFullYear() === e.getFullYear()) return dm(d) + ' – ' + dmy(e);
      return dmy(d) + ' – ' + dmy(e);
    }
    return dmy(d);
  }

  var now = new Date();
  var upcoming = concerts
    .filter(function(c) { return endOf(c) >= now; })
    .sort(function(a, b) { return new Date(a.date) - new Date(b.date); })
    .slice(0, 3);

  var list = document.querySelector('.upcoming-list');
  if (!list) return;
  if (upcoming.length === 0) {
    var section = document.getElementById('upcoming-section');
    if (section) section.style.display = 'none';
  } else {
    /* Same date treatment as the concerts overview: light weekday,
       big serif day number, month stacked over year */
    function dateBlock(c) {
      var d = new Date(c.date);
      function stack(day, wd, month) {
        return '<span class="concert-row-day">' + wd + '</span>' +
          '<span class="concert-row-datemain">' +
            '<span class="concert-row-daynum">' + day + '</span>' +
            '<span class="concert-row-monthyear"><span>' + month + '</span><span>' + d.getFullYear() + '</span></span>' +
          '</span>';
      }
      if (c.monthOnly && !c.dateEnd) {
        return '<span class="concert-row-day">' + d.toLocaleDateString(lang, { month: 'long', year: 'numeric' }) + '</span>';
      }
      if (c.dateEnd) {
        var e = new Date(c.dateEnd);
        var sameMonth = d.getMonth() === e.getMonth() && d.getFullYear() === e.getFullYear();
        return stack(
          d.getDate() + '\u2009\u2013\u2009' + e.getDate(),
          d.toLocaleDateString(lang, { weekday: 'short' }) + ' \u2013 ' + e.toLocaleDateString(lang, { weekday: 'short' }),
          sameMonth ? d.toLocaleDateString(lang, { month: 'long' })
                    : d.toLocaleDateString(lang, { month: 'short' }) + ' \u2013 ' + e.toLocaleDateString(lang, { month: 'short' }));
      }
      return stack(d.getDate(), d.toLocaleDateString(lang, { weekday: 'long' }), d.toLocaleDateString(lang, { month: 'long' }));
    }
    list.innerHTML = upcoming.map(function(c) {
      return '<li>' +
        '<a class="upcoming-item upcoming-item--rich" href="' + c.link + '">' +
          '<span class="upcoming-item-when">' + dateBlock(c) +
            (c.place ? '<span class="concert-row-where">' + c.place + '</span>' : '') +
          '</span>' +
          '<span class="upcoming-item-title">' + c.title + '</span>' +
        '</a>' +
      '</li>';
    }).join('');

    /* Modal first — the full page stays one click away inside it */
    window.concertNavOrder = upcoming;
    Array.prototype.forEach.call(list.querySelectorAll('a.upcoming-item'), function (a, i) {
      a.addEventListener('click', function (e) {
        if (!window.openConcertModal || e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        openConcertModal(upcoming[i]);
      });
    });
  }
});
</script>
