<script>document.documentElement.classList.add('js');</script>
{% assign ogImage = image | default: "/images/veroniqueportrait.jpg" %}
<meta property="og:site_name" content="Veronique De Raedemaeker">
<meta property="og:title" content="{% if title %}{{ title | escape }} — {% endif %}Veronique De Raedemaeker">
<meta property="og:type" content="website">
<meta property="og:url" content="https://veroniquederaedemaeker.com{{ page.url }}">
<meta property="og:image" content="https://veroniquederaedemaeker.com{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title | escape }} — {% endif %}Veronique De Raedemaeker">
<meta name="twitter:image" content="https://veroniquederaedemaeker.com{{ ogImage }}">
<link rel="preload" href="/images/AppleGaramond-Light.ttf" as="font" type="font/ttf" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
{% assign cssv = "now" | date: "%s" %}
<link rel="stylesheet" href="/css/base.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/layout.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/components.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/pages.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/theme.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/progressive.css?v={{ cssv }}">
<script defer src="/js/main.js?v={{ cssv }}"></script>
