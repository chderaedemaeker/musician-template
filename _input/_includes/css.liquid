<script>document.documentElement.classList.add('js');</script>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#2a281c">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#f5f4f2">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Veronique De Raedemaeker",
  "jobTitle": "Violinist",
  "url": "https://veroniquederaedemaeker.com/",
  "image": "https://veroniquederaedemaeker.com/images/veroniqueportrait.jpg",
  "nationality": "Belgian",
  "workLocation": { "@type": "Place", "address": "Cologne, Germany" }
}
</script>
{% assign ogImage = image | default: "/images/veroniqueportrait.jpg" %}
<meta property="og:site_name" content="Veronique De Raedemaeker">
<meta property="og:title" content="{% if title %}{{ title | escape }} — {% endif %}Veronique De Raedemaeker">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage | replace: " ", "%20" }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title | escape }} — {% endif %}Veronique De Raedemaeker">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage | replace: " ", "%20" }}">
{% comment %} Detail pages (highlights, projects, concerts, notes, about) describe
   themselves with the opening of their own text {% endcomment %}
{% if layout != "default.html" %}{% capture ogDescRaw %}{{ content | strip_html }}{% endcapture %}{% assign ogDesc = ogDescRaw | strip_newlines | strip | truncate: 200 %}{% if ogDesc != "" %}<meta property="og:description" content="{{ ogDesc | escape }}">
<meta name="twitter:description" content="{{ ogDesc | escape }}">
<meta name="description" content="{{ ogDesc | escape }}">
{% endif %}{% endif %}<link rel="preload" href="/images/AppleGaramond-Light.ttf" as="font" type="font/ttf" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
{% assign cssv = "now" | date: "%s" %}
<link rel="stylesheet" href="/css/base.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/layout.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/components.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/pages.css?v={{ cssv }}">
<link rel="stylesheet" href="/css/theme.css?v={{ cssv }}">
{% if site.footer_colors %}
<style>
  /* Footer colours — managed in the admin's Site settings */
  .footer { background-color: {{ site.footer_colors.background | default: '#5c8ca3' }}; }
  .footer-heading, .footer-col a, .footer-bottom p, .footer-news-title,
  .footer-news-row input, .bento-contact .label, .footer-col a.active {
    color: {{ site.footer_colors.text | default: '#1d2440' }};
  }
  .footer-news-row input { border-color: {{ site.footer_colors.text | default: '#1d2440' }}73; }
  .footer-news-row input::placeholder { color: {{ site.footer_colors.text | default: '#1d2440' }}; opacity: .55; }
  .footer-col a:hover, .footer-col a.active { text-decoration-color: {{ site.footer_colors.text | default: '#1d2440' }}; }
  .footer-watermark { color: {{ site.footer_colors.logo | default: '#2a4b5a' }}; }
</style>
{% endif %}
<link rel="stylesheet" href="/css/progressive.css?v={{ cssv }}">
<script defer src="/js/main.js?v={{ cssv }}"></script>
