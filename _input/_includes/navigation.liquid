{% assign lang = "" %}
{% if page.url contains '/en/' %}
  {% assign lang = "en" %}
{% elsif page.url contains '/nl/' %}
  {% assign lang = "nl" %}
{% elsif page.url contains '/fr/' %}
  {% assign lang = "fr" %}
{% elsif page.url contains '/de/' %}
  {% assign lang = "de" %}
{% else %}
  {% assign lang = "en" %}
{% endif %}

<nav class="nav{% if navTransparent %} nav-transparent{% endif %}">
  <div class="nav-inner">
    <div class="nav-brand">
      <a href="/{{ lang }}/">Veronique De Raedemaeker</a>
    </div>

    <div class="nav-links">
      {% for item in navigation[lang] %}
        <a href="{{ item.url }}"{% if page.url == item.url %} class="active" aria-current="page"{% endif %}>{{ item.text }}</a>
      {% endfor %}
    </div>

    <div class="lang-picker">
      <button type="button" class="lang-picker-btn" aria-haspopup="true" aria-expanded="false" aria-label="Language">{{ lang }} <span class="lang-caret" aria-hidden="true">&#9662;</span></button>
      <div class="lang-picker-menu" hidden>
        {% assign langCodes = "en|nl|fr|de" | split: "|" %}
        {% for code in langCodes %}
          <a href="/{{ code }}/" {% if lang == code %}class="active" aria-current="true"{% endif %} onclick="switchLanguage('{{ code }}'); return false;">{{ code }}</a>
        {% endfor %}
      </div>
    </div>

    <button class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" onclick="toggleMobileNav()">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="mobile-nav" id="mobile-nav">
  {% for item in navigation[lang] %}
    <a href="{{ item.url }}" style="--i: {{ forloop.index0 }}">{{ item.text }}</a>
  {% endfor %}
  <form name="newsletter" method="POST" data-netlify="true" action="/{{ lang }}/contact/success/" class="mobile-nav-news" style="--i: 5">
    <input type="hidden" name="form-name" value="newsletter">
    <p class="mobile-nav-news-title">{{ languages[lang].newsletter_hint }}</p>
    <div class="mobile-nav-news-row">
      <input required type="email" name="email" placeholder="{{ languages[lang].your_email }}" aria-label="{{ languages[lang].your_email }}">
      <button type="submit" class="btn">{{ languages[lang].subscribe }}</button>
    </div>
  </form>
  <nav class="lang-switcher" aria-label="Language" style="--i: 6">
    {% assign langCodes = "en|nl|fr|de" | split: "|" %}
    {% for code in langCodes %}
      <a href="/{{ code }}/" {% if lang == code %}class="active" aria-current="true"{% endif %} onclick="switchLanguage('{{ code }}'); return false;">{{ code }}</a>
    {% endfor %}
  </nav>
</div>
