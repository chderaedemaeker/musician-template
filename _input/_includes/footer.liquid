{% assign lang = "" %}
{% if page.url contains '/en/' %}
  {% assign lang = "en" %}
{% elsif page.url contains '/nl/' %}
  {% assign lang = "nl" %}
{% elsif page.url contains '/fr/' %}
  {% assign lang = "fr" %}
{% elsif page.url contains '/de/' %}
  {% assign lang = "de" %}
{% else %}
  {% assign lang = "en" %}
{% endif %}

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-heading">{{ languages[lang].footer_navigate }}</p>
        <ul>
          {% for item in navigation[lang] %}
          <li><a href="{{ item.url }}">{{ item.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">{{ languages[lang].footer_follow }}</p>
        <ul>
          <li><a href="https://www.facebook.com/veronique.deraedemaeker" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://www.instagram.com/veronique.deraedemaeker/" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://www.youtube.com/@veroniquederaedemaeker" target="_blank" rel="noopener">YouTube</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">{{ languages[lang].contact_title }}</p>
        <ul>
          <li><a href="/{{ lang }}/contact/">{{ languages[lang].send_message }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">{{ languages[lang].footer_language }}</p>
        <ul>
          {% assign langCodes = "en|nl|fr|de" | split: "|" %}
          {% for code in langCodes %}
          <li><a href="/{{ code }}/"{% if lang == code %} class="active" aria-current="true"{% endif %} onclick="switchLanguage('{{ code }}'); return false;">{{ languages[code].native_name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-news">
        <p class="footer-news-title">{{ languages[lang].newsletter_hint }}</p>
        <form name="newsletter" method="POST" data-netlify="true" action="/en/contact/success/" class="footer-news-row">
          <input type="hidden" name="form-name" value="newsletter">
          <input required type="email" name="email" placeholder="{{ languages[lang].your_email }}" aria-label="{{ languages[lang].your_email }}">
          <button type="submit" class="btn">{{ languages[lang].subscribe }}</button>
        </form>
      </div>
    </div>

    <p class="footer-watermark" aria-hidden="true">{{ languages[lang].site_title }}</p>

    <div class="footer-bottom">
      <p>&copy; {{ "now" | date: "%Y" }} {{ languages[lang].site_title }}. {{ languages[lang].copyright }}</p>
      <p>{{ languages[lang].footer_based }}</p>
    </div>
  </div>
</footer>
