{% assign lang = page.lang %}
<div class="concert-modal" id="concert-modal" hidden>
  <div class="concert-modal-backdrop" onclick="closeConcertModal()"></div>
  <div class="concert-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cm-title" tabindex="-1">
    <button class="concert-modal-close" aria-label="Close" onclick="closeConcertModal()">&#215;</button>
    <p class="concert-modal-date" id="cm-date"></p>
    <h2 class="concert-modal-title" id="cm-title"></h2>
    <div class="concert-modal-meta" id="cm-meta"></div>
    <div class="concert-modal-body" id="cm-body"></div>
    <div class="concert-modal-actions">
      <a class="btn" id="cm-ticket" target="_blank" rel="noopener" hidden>{{ languages[lang].tickets }}</a>
      <button type="button" class="btn" id="cm-cal" hidden><svg class="btn-ico" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M12 13.5v5M9.5 16h5"/></svg>{{ languages[lang].add_to_calendar }}</button>
      <a class="btn btn-sm" id="cm-page" hidden>{{ languages[lang].full_page }} <span aria-hidden="true">&#8594;</span></a>
      <button type="button" class="action-btn action-share" id="cm-share" data-copied="{{ languages[lang].link_copied }}" aria-label="{{ languages[lang].share }}" title="{{ languages[lang].share }}">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M8 7l4-4 4 4"/><path d="M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></svg>
      </button>
    </div>
    <div class="concert-modal-nav">
      <button type="button" class="concert-modal-nav-btn" id="cm-prev" hidden><span aria-hidden="true">&#8592;</span> {{ languages[lang].previous }}</button>
      <button type="button" class="concert-modal-nav-btn" id="cm-next" hidden>{{ languages[lang].next }} <span aria-hidden="true">&#8594;</span></button>
    </div>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('concert-modal');
  var panel = modal.querySelector('.concert-modal-panel');
  var lastTrigger = null;
  var closeTimer = null;
  var currentConcert = null;

  function navStep(delta) {
    var order = window.concertNavOrder || [];
    var idx = order.indexOf(currentConcert);
    var target = order[idx + delta];
    if (idx !== -1 && target) window.openConcertModal(target, true);
  }

  window.openConcertModal = function (c, keepFocus) {
    currentConcert = c;
    var order = window.concertNavOrder || [];
    var idx = order.indexOf(c);
    document.getElementById('cm-prev').hidden = idx <= 0;
    document.getElementById('cm-next').hidden = idx === -1 || idx >= order.length - 1;
    var dateText = window.concertDateStr
      ? window.concertDateStr(c, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
      : '';
    /* Single-day concerts with a real hour also show the time */
    if (!c.monthOnly && !c.dateEnd) {
      var d = new Date(c.date);
      if (d.getHours() !== 0 || d.getMinutes() !== 0) {
        dateText += ' — ' + d.toLocaleTimeString(document.documentElement.lang || 'en', { hour: '2-digit', minute: '2-digit' });
      }
    }
    document.getElementById('cm-date').textContent = dateText;
    document.getElementById('cm-title').textContent = c.title || '';

    var meta = document.getElementById('cm-meta');
    meta.innerHTML = '';
    function projectFor(text) {
      if (!text || !window.projectLinks) return null;
      var t = text.toLowerCase();
      for (var i = 0; i < window.projectLinks.length; i++) {
        var words = (window.projectLinks[i].words || '').split(',');
        for (var j = 0; j < words.length; j++) {
          var w = words[j].trim();
          if (w && t.indexOf(w) !== -1) return window.projectLinks[i].url;
        }
      }
      return null;
    }
    [[c.place, false], [c.composers, false], [c.collaborators, true]].forEach(function (entry) {
      var value = entry[0];
      if (!value) return;
      var span = document.createElement('span');
      var projUrl = entry[1] ? projectFor(value) : null;
      if (projUrl) {
        var a = document.createElement('a');
        a.href = projUrl;
        a.textContent = value;
        span.appendChild(a);
      } else {
        span.textContent = value;
      }
      meta.appendChild(span);
    });

    document.getElementById('cm-body').innerHTML = c.body || '';

    var ticket = document.getElementById('cm-ticket');
    ticket.hidden = !c.ticket;
    if (c.ticket) ticket.href = c.ticket;

    var cal = document.getElementById('cm-cal');
    var lastDay = new Date(c.dateEnd || c.date);
    lastDay.setHours(23, 59, 59);
    cal.hidden = lastDay < new Date();

    var page = document.getElementById('cm-page');
    page.hidden = !c.link;
    if (c.link) page.href = c.link;

    var share = document.getElementById('cm-share');
    share.dataset.shareUrl = location.origin + (c.link || location.pathname);
    share.dataset.shareTitle = (c.title || '') + ' \u2014 Veronique De Raedemaeker';

    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    if (!keepFocus) lastTrigger = document.activeElement;
    modal.hidden = false;
    document.body.classList.add('modal-open');
    /* Let the browser paint the hidden→shown state before transitioning */
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        modal.classList.add('is-open');
      });
    });
    panel.scrollTop = 0;
    if (!keepFocus) panel.focus();
  };

  document.getElementById('cm-cal').addEventListener('click', function () {
    if (currentConcert && window.downloadConcertIcs) window.downloadConcertIcs(currentConcert);
  });

  document.getElementById('cm-prev').addEventListener('click', function () { navStep(-1); });
  document.getElementById('cm-next').addEventListener('click', function () { navStep(1); });

  window.closeConcertModal = function () {
    if (modal.hidden) return;
    modal.classList.remove('is-open');
    document.body.classList.remove('modal-open');
    closeTimer = setTimeout(function () {
      modal.hidden = true;
      closeTimer = null;
    }, 300);
    if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
    lastTrigger = null;
  };

  document.addEventListener('keydown', function (e) {
    if (modal.hidden) return;
    if (e.key === 'Escape') closeConcertModal();
    if (e.key === 'ArrowLeft') navStep(-1);
    if (e.key === 'ArrowRight') navStep(1);
    if (e.key === 'Tab' && window.siteTrapFocus) window.siteTrapFocus(panel, e);
  });
})();
</script>
