{% assign lang = page.lang %}

<div class="container-content">

  <header class="page-header">
    <p class="label">{{ languages[lang].site_subtitle }}</p>
    <h1>{{ languages[lang].projects_title }}</h1>
  </header>

  {% assign langProjects = 'projects_' | append: lang %}
  {% assign sortedProjects = collections[langProjects] | sort: 'date' | reverse %}

  <ul class="text-list">
    {% if sortedProjects.size > 0 %}
      {% for project in sortedProjects %}
        <li>
          <a href="{{ project.url }}" class="text-list-item">
            <div class="text-list-left">
              <h3 class="text-list-title">{{ project.data.title }}</h3>
              {% if project.data.collaborators %}<p class="text-list-detail">{{ project.data.collaborators }}</p>{% endif %}
            </div>
            <span class="text-list-arrow" aria-hidden="true">&#8594;</span>
          </a>
        </li>
      {% endfor %}
    {% else %}
      <li><p class="empty-note">{{ languages[lang].no_projects }}</p></li>
    {% endif %}
  </ul>

</div>
