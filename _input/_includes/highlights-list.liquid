{% assign lang = page.lang %}
{% assign langUrl = '/' | append: lang | append: '/' %}

{% assign langHighlights = 'highlights_' | append: lang %}
{% assign sortedHighlights = collections[langHighlights] | sort: 'date' | reverse %}

<div class="highlights-section">
  <div class="container">
    <header class="page-header page-header--actions">
      <h1>{{ languages[lang].highlights_title }}</h1>
      {% include "share-actions.liquid" %}
    </header>
  <div class="hl-filters" role="group" aria-label="Filter">
    <button type="button" class="hl-filter active" data-cat="all">{{ languages[lang].filter_all }}</button>
    {% assign hlCats = "Discography|Video|Recording|Concert" | split: "|" %}
    {% for c in hlCats %}
    {% assign catKey = "cat_" | append: c | downcase %}
    <button type="button" class="hl-filter" data-cat="{{ c }}">{{ languages[lang][catKey] }}</button>
    {% endfor %}
  </div>
  <div class="highlights-grid highlights-grid--large reveal-group">
    {% if sortedHighlights.size > 0 %}
      {% for highlight in sortedHighlights %}
        <a href="/highlights/{{ lang }}/{{ highlight.inputPath | split: '/' | last | replace: '.md', '' }}/" class="highlight-card reveal{% if highlight.data.featured %} highlight-card--featured{% endif %}{% unless highlight.data.image and highlight.data.image != '' %} highlight-card--noimg{% endunless %}" data-cats="{{ highlight.data.type }}"{% if highlight.data.image and highlight.data.image != '' %} style="--shade-rgb: {{ highlight.data.image | imageShade }};"{% endif %} {% unless highlight.data.image and highlight.data.image != '' %}data-initial="{{ highlight.data.title | strip | slice: 0, 1 | upcase }}"{% endunless %}>
          {% if highlight.data.image and highlight.data.image != '' %}
            {% progressiveImage highlight.data.image, highlight.data.title %}
          {% endif %}
          <div class="highlight-card-overlay">
            <div class="highlight-card-top">
              {% if highlight.data.type %}<p class="highlight-card-type">{% assign hcats = highlight.data.type | split: ", " %}{% for hc in hcats %}{% assign hck = "cat_" | append: hc | downcase %}{{ languages[lang][hck] | default: hc }}{% unless forloop.last %} &middot; {% endunless %}{% endfor %}</p>{% endif %}
              <h3 class="highlight-card-title">{{ highlight.data.title }}</h3>
            </div>
            <span class="card-cta" aria-hidden="true"><span class="card-cta-text">{{ languages[lang].view }}</span><span class="card-cta-arrow">&#8594;</span></span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      <p class="empty-note">{{ languages[lang].no_highlights }}</p>
    {% endif %}
  </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var pills = document.querySelectorAll('.hl-filter');
  if (!pills.length) return;
  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      pills.forEach(function (pl) { pl.classList.toggle('active', pl === pill); });
      var cat = pill.dataset.cat;
      document.querySelectorAll('.highlight-card').forEach(function (card) {
        var cats = (card.dataset.cats || '').split(',').map(function (c) { return c.trim(); });
        card.style.display = (cat === 'all' || cats.indexOf(cat) !== -1) ? '' : 'none';
      });
    });
  });
});
</script>
