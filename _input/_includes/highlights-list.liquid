{% assign lang = page.lang %}
{% assign langUrl = '/' | append: lang | append: '/' %}

{% assign langHighlights = 'highlights_' | append: lang %}
{% assign sortedHighlights = collections[langHighlights] | sort: 'date' | reverse %}

<div class="highlights-section">
  <div class="container">
    <header class="page-header page-header--actions">
      <h1>{{ languages[lang].highlights_title }}</h1>
      {% include "share-actions.liquid" %}
    </header>
  <div class="highlights-grid highlights-grid--large reveal-group">
    {% if sortedHighlights.size > 0 %}
      {% for highlight in sortedHighlights %}
        <a href="/highlights/{{ lang }}/{{ highlight.inputPath | split: '/' | last | replace: '.md', '' }}/" class="highlight-card reveal{% if highlight.data.featured %} highlight-card--featured{% endif %}{% unless highlight.data.image and highlight.data.image != '' %} highlight-card--noimg{% endunless %}" {% unless highlight.data.image and highlight.data.image != '' %}data-initial="{{ highlight.data.title | strip | slice: 0, 1 | upcase }}"{% endunless %}>
          {% if highlight.data.image and highlight.data.image != '' %}
            {% progressiveImage highlight.data.image, highlight.data.title %}
          {% endif %}
          <div class="highlight-card-overlay">
            <div class="highlight-card-top">
              {% if highlight.data.type %}<p class="highlight-card-type">{{ highlight.data.type }}</p>{% endif %}
              <h3 class="highlight-card-title">{{ highlight.data.title }}</h3>
            </div>
            <span class="card-cta" aria-hidden="true"><span class="card-cta-text">{{ languages[lang].view }}</span><span class="card-cta-arrow">&#8594;</span></span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      <p class="empty-note">{{ languages[lang].no_highlights }}</p>
    {% endif %}
  </div>
</div>
</div>
