{% assign navTransparent = true %}
{% include "navigation.liquid" %}

{% assign lang = page.lang %}

<main>

<div class="hero-fullscreen">
  {% assign heroAlt = languages[lang].site_title %}{% progressiveImage site.hero_image, heroAlt %}
  <div class="hero-content">
    <p class="hero-eyebrow label">{{ languages[lang].site_subtitle }}</p>
    <h1 class="hero-title">{{ languages[lang].site_title }}</h1>
  </div>
</div>

<!-- Short bio -->
{% assign aboutPage = collections.about | where: "data.lang", lang | first %}
{% if aboutPage and aboutPage.data.summaryabout %}
<section class="section container-prose home-intro reveal">
  <p class="lede">{{ aboutPage.data.summaryabout }}</p>
  <a class="btn" href="/{{ lang }}/about/">{{ languages[lang].biography }} <span aria-hidden="true">&#8594;</span></a>
</section>
{% endif %}

<!-- Upcoming concerts -->
{% include "upcoming-concerts.liquid" %}

<!-- Latest highlight -->
{% assign langHighlights = 'highlights_' | append: lang %}
{% assign latestHighlight = collections[langHighlights] | sort: 'date' | reverse | first %}
{% if latestHighlight %}
<section class="section container-content reveal">

  <div class="home-section-header">
    <h2 class="label">{{ languages[lang].most_recent_highlight }}</h2>
  </div>

  <div class="highlights-grid">
    <a href="{{ latestHighlight.url }}" class="highlight-card highlight-card--solo{% unless latestHighlight.data.image and latestHighlight.data.image != '' %} highlight-card--noimg{% endunless %}" {% unless latestHighlight.data.image and latestHighlight.data.image != '' %}data-initial="{{ latestHighlight.data.title | strip | slice: 0, 1 | upcase }}"{% endunless %}>
      {% if latestHighlight.data.image and latestHighlight.data.image != '' %}
        <img src="{{ latestHighlight.data.image }}" alt="{{ latestHighlight.data.title }}">
      {% endif %}
      <div class="highlight-card-overlay">
        <div class="highlight-card-top">
          {% if latestHighlight.data.type %}<p class="highlight-card-type">{{ latestHighlight.data.type }}</p>{% endif %}
          <h3 class="highlight-card-title">{{ latestHighlight.data.title }}</h3>
        </div>
      </div>
    </a>
  </div>

  <div class="home-more">
    <a class="btn" href="/{{ lang }}/highlights/">{{ languages[lang].see_all_highlights }} <span aria-hidden="true">&#8594;</span></a>
  </div>

</section>
{% endif %}

<!-- Contact -->
<section class="section container-prose text-center reveal">
  <div class="home-section-header">
    <h2 class="label">{{ languages[lang].contact_title }}</h2>
  </div>
  <a class="btn" href="/{{ lang }}/contact/">{{ languages[lang].contact_title }} <span aria-hidden="true">&#8594;</span></a>
</section>

</main>
