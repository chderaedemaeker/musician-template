{% assign navTransparent = true %}
{% include "navigation.liquid" %}

<main>

<div class="hero-fullscreen">
  {% assign heroAlt = languages[page.lang].site_title %}{% progressiveImage site.hero_image, heroAlt %}
  <div class="hero-content">
  </div>
</div>

{% assign lang = page.lang %}

<!-- Short Bio -->
{% assign aboutPage = collections.about | where: "data.lang", lang | first %}
{% if aboutPage and aboutPage.data.summaryabout %}
<div style="max-width: var(--content-width); margin: 0 auto; padding: var(--space-xl) var(--space-md); text-align: center;">
  <p style="font-size: var(--serif-body); font-family: var(--font-serif); font-weight: 300; line-height: 1.6; color: var(--near-black); margin: 0 0 var(--space-lg);">{{ aboutPage.data.summaryabout }}</p>
  <a class="btn" href="/{{ lang }}/about/">{{ languages[lang].biography }}</a>
</div>
{% endif %}

<!-- Upcoming Concerts -->
{% include "upcoming-concerts.liquid" %}

<!-- Latest Highlight -->
{% assign langHighlights = 'highlights_' | append: lang %}
{% assign latestHighlight = collections[langHighlights] | sort: 'date' | reverse | first %}
{% if latestHighlight %}
<div style="padding: var(--space-xl) 0;">

  <h2 class="section-title" style="margin-bottom: var(--space-lg);">{{ languages[lang].most_recent_highlight }}</h2>

  <div class="highlights-grid">
    <a href="{{ latestHighlight.url }}" class="highlight-card">
      {% if latestHighlight.data.image %}
        <img src="{{ latestHighlight.data.image }}" alt="{{ latestHighlight.data.title }}">
      {% endif %}
      <div class="highlight-card-overlay">
        <div class="highlight-card-top">
          {% if latestHighlight.data.type %}<p class="highlight-card-type">{{ latestHighlight.data.type }}</p>{% endif %}
          <h3 class="highlight-card-title">{{ latestHighlight.data.title }}</h3>
        </div>
      </div>
    </a>
  </div>

  <div style="text-align: center; margin-top: var(--space-lg);">
    <a class="btn" href="/{{ lang }}/highlights/">{{ languages[lang].see_all_highlights }}</a>
  </div>

</div>
{% endif %}

<!-- Contact -->
<div style="text-align: center; padding: var(--space-xl) var(--space-md);">
  <a class="btn" href="/{{ lang }}/contact/">{{ languages[lang].contact_title }}</a>
</div>

</main>
