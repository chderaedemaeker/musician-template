{% assign navTransparent = true %}
{% include "navigation.liquid" %}

{% assign lang = page.lang %}
{% assign langUrl = '/' | append: lang | append: '/' %}

<main>

<div class="hero-fullscreen">
  {% assign heroAlt = languages[lang].site_title %}{% progressiveImage site.hero_image, heroAlt %}
</div>

<!-- Latest note — a quiet thought drifting above the grid -->
{% assign latestNote = collections.notes | sort: 'date' | reverse | first %}
{% if latestNote %}
<section class="note-drift" aria-label="{{ languages[lang].notes_title }}">
  <a class="note-drift-link" href="{{ latestNote.url }}">
    <p class="note-drift-text">&ldquo;{{ latestNote.templateContent | strip_html | strip_newlines | truncate: 180 }}&rdquo;</p>
    <span class="note-drift-meta">{{ latestNote.date | shortDate }} &middot; {{ languages[lang].notes_title }} <span aria-hidden="true">&#8594;</span></span>
  </a>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var box = document.querySelector('.note-drift');
  if (!box) return;
  var textEl = box.querySelector('.note-drift-text');
  var words = textEl.textContent.trim().split(/\s+/);
  textEl.textContent = '';
  words.forEach(function (w, i) {
    /* outer span: one-time entrance; inner span: perpetual float and pulse,
       each word on its own rhythm */
    var outer = document.createElement('span');
    outer.className = 'nw';
    outer.style.transitionDelay = (i * 0.15) + 's';
    var inner = document.createElement('span');
    inner.className = 'nw-i';
    inner.style.animationDuration = (3.4 + (i % 5) * 0.5) + 's';
    inner.style.animationDelay = '-' + ((i * 0.73) % 3.4).toFixed(2) + 's';
    inner.textContent = w;
    outer.appendChild(inner);
    textEl.appendChild(outer);
    textEl.appendChild(document.createTextNode(' '));
  });
  var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  function start() {
    box.classList.add('is-live');
    if (!reduced) {
      /* once every word has arrived, let the whole thought recede a little */
      setTimeout(function () { box.classList.add('is-settled'); }, words.length * 130 + 2300);
    }
  }
  if ('IntersectionObserver' in window && !reduced) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { start(); io.disconnect(); } });
    }, { threshold: 0.3 });
    io.observe(box);
  } else { start(); }
});
</script>
{% endif %}

<!-- Bento: everything at a glance -->
<section class="section container">
  <div class="bento reveal-group bento--nonotes">

    <!-- Latest highlight — newest entry that has a real date -->
    {% assign langHighlights = 'highlights_en' %}
    {% assign sortedHighlightsHome = collections[langHighlights] | sort: 'date' | reverse %}
    {% assign latestFound = false %}
    {% for h in sortedHighlightsHome %}
      {% if latestFound == false and h.data.date and h.data.date != '' %}
        {% assign latestHighlight = h %}
        {% assign latestFound = true %}
      {% endif %}
    {% endfor %}
    {% if latestFound == false %}{% assign latestHighlight = sortedHighlightsHome | first %}{% endif %}
    {% if latestHighlight %}
    <a href="/highlights/{{ lang }}/{{ latestHighlight.inputPath | split: '/' | last | replace: '.md', '' }}/" class="bento-cell bento-highlight reveal{% unless latestHighlight.data.image and latestHighlight.data.image != '' %} bento-highlight--noimg{% endunless %}" {% unless latestHighlight.data.image and latestHighlight.data.image != '' %}data-initial="{{ latestHighlight.data.title | strip | slice: 0, 1 | upcase }}"{% endunless %}>
      {% if latestHighlight.data.image and latestHighlight.data.image != '' %}
        {% progressiveImage latestHighlight.data.image, latestHighlight.data.title %}
      {% endif %}
      <div class="bento-highlight-overlay">
        <p class="bento-highlight-label">{{ languages[lang].most_recent_highlight }}</p>
        <h3 class="bento-highlight-title">{{ latestHighlight.data.title }}</h3>
        <span class="card-cta" aria-hidden="true"><span class="card-cta-text">{{ languages[lang].view }}</span><span class="card-cta-arrow">&#8594;</span></span>
      </div>
    </a>
    {% endif %}

    <!-- Upcoming concerts -->
    <div class="bento-cell bento-concerts reveal" id="upcoming-section">
      <h2 class="label">{{ languages[lang].upcoming_concerts }}</h2>
      {% include "upcoming-concerts.liquid" %}
      <a class="bento-cell-link" href="/{{ lang }}/concerts/">{{ languages[lang].see_all_concerts }} <span aria-hidden="true">&#8594;</span></a>
    </div>

    <!-- Contact -->
    <div class="bento-cell bento-contact reveal">
      <h2 class="label">{{ languages[lang].contact_title }}</h2>
      <p class="bento-contact-text">{{ languages[lang].contact_intro }}</p>
      <a class="btn" href="/{{ lang }}/contact/">{{ languages[lang].contact_title }} <span aria-hidden="true">&#8594;</span></a>
    </div>

  </div>
</section>

</main>

{% include "concert-modal.liquid" %}
