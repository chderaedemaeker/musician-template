{% assign navTransparent = true %}
{% include "navigation.liquid" %}

{% assign lang = page.lang %}
{% assign langUrl = '/' | append: lang | append: '/' %}

<main>

<div class="hero-fullscreen">
  {% assign heroAlt = languages[lang].site_title %}{% progressiveImage site.hero_image, heroAlt %}
  <span class="hero-scroll-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l7 7 7-7"/></svg>
  </span>
</div>

<!-- Latest note — a quiet thought drifting above the grid; the thought
     itself is the link, nothing else -->
{% assign latestNote = collections.notes | sort: 'date' | reverse | first %}
{% if latestNote %}
<section class="note-drift" aria-label="{{ languages[lang].notes_title }}">
  <a class="note-drift-link" href="/en/notes/" aria-label="{{ languages[lang].notes_title }}">
    <p class="note-drift-text">{{ latestNote.templateContent | strip_html }}</p>
    <span class="note-drift-meta"><span class="note-drift-date">{{ latestNote.date | shortDate }} &middot; {{ latestNote.data.title }}</span></span>
  </a>
  {% assign photos = latestNote.data.photos %}
  {% assign title = latestNote.data.title %}
  {% assign notePhotosExtra = " note-photos--index" %}
  {% include "note-photos.liquid" %}
  {% assign notePhotosExtra = "" %}
</section>
{% endif %}

<!-- Bento: everything at a glance -->
<section class="section container">
  <div class="bento reveal-group bento--nonotes">

    <!-- Latest highlight — newest entry that has a real date -->
    {% assign langHighlights = 'highlights_en' %}
    {% assign sortedHighlightsHome = collections[langHighlights] | sort: 'date' | reverse %}
    {% assign latestFound = false %}
    {% for h in sortedHighlightsHome %}
      {% if latestFound == false and h.data.date and h.data.date != '' %}
        {% assign latestHighlight = h %}
        {% assign latestFound = true %}
      {% endif %}
    {% endfor %}
    {% if latestFound == false %}{% assign latestHighlight = sortedHighlightsHome | first %}{% endif %}
    {% if latestHighlight %}
    <a href="/highlights/{{ lang }}/{{ latestHighlight.inputPath | split: '/' | last | replace: '.md', '' }}/" class="bento-cell bento-highlight reveal{% unless latestHighlight.data.image and latestHighlight.data.image != '' %} bento-highlight--noimg{% endunless %}" {% if latestHighlight.data.image and latestHighlight.data.image != '' %}style="--card-shade: rgba({{ latestHighlight.data.image | imageShade }}, 0.62); --card-shade-soft: rgba({{ latestHighlight.data.image | imageShade }}, 0.04);"{% endif %} {% unless latestHighlight.data.image and latestHighlight.data.image != '' %}data-initial="{{ latestHighlight.data.title | strip | slice: 0, 1 | upcase }}"{% endunless %}>
      {% if latestHighlight.data.image and latestHighlight.data.image != '' %}
        {% progressiveImage latestHighlight.data.image, latestHighlight.data.title %}
      {% endif %}
      <div class="bento-highlight-overlay">
        <p class="bento-highlight-label">{{ languages[lang].most_recent_highlight }}</p>
        <h3 class="bento-highlight-title">{{ latestHighlight.data.title }}</h3>
        <span class="card-cta" aria-hidden="true"><span class="card-cta-text">{{ languages[lang].view }}</span><span class="card-cta-arrow">&#8594;</span></span>
      </div>
    </a>
    {% endif %}

    <!-- Upcoming concerts -->
    <div class="bento-cell bento-concerts reveal" id="upcoming-section">
      <h2 class="label">{{ languages[lang].upcoming_concerts }}</h2>
      {% include "upcoming-concerts.liquid" %}
      <a class="bento-cell-link" href="/{{ lang }}/concerts/">{{ languages[lang].see_all_concerts }} <span aria-hidden="true">&#8594;</span></a>
    </div>

    <!-- Contact -->
    <div class="bento-cell bento-contact reveal">
      <h2 class="label">{{ languages[lang].contact_title }}</h2>
      <p class="bento-contact-text">{{ languages[lang].contact_intro }}</p>
      <a class="btn" href="/{{ lang }}/contact/">{{ languages[lang].contact_title }} <span aria-hidden="true">&#8594;</span></a>
    </div>

  </div>
</section>

</main>

{% include "concert-modal.liquid" %}
