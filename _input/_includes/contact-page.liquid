{% assign lang = page.lang %}

<div class="contact-page">

  <header class="page-header">
    <h1>{{ languages[lang].contact_title }}</h1>
    <p class="lede">{{ languages[lang].contact_intro }}</p>
  </header>

  <h2>{{ languages[lang].send_message }}</h2>

  <form name="contact" method="POST" data-netlify="true" action="/{{ lang }}/contact/success/">
    <input type="hidden" name="form-name" value="contact">
    <div class="form-group">
      <label for="name">{{ languages[lang].your_name }}</label>
      <input required type="text" id="name" name="name" autocomplete="name">
    </div>
    <div class="form-group">
      <label for="email">{{ languages[lang].your_email }}</label>
      <input required type="email" id="email" name="email" autocomplete="email">
    </div>
    <div class="form-group">
      <label for="message">{{ languages[lang].message }}</label>
      <textarea required id="message" name="message"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">{{ languages[lang].send_button }}</button>
  </form>

  <div class="contact-divider"></div>

  <div class="contact-footer">
    <div>
      <h2>{{ languages[lang].newsletter }}</h2>
      <p class="contact-newsletter-hint">{{ languages[lang].newsletter_hint }}</p>
      <form name="newsletter" method="POST" data-netlify="true" action="/{{ lang }}/contact/success/" class="newsletter-form">
        <input type="hidden" name="form-name" value="newsletter">
        <label for="newsletter-email">{{ languages[lang].your_email }}</label>
        <div class="newsletter-row">
          <input required type="email" id="newsletter-email" name="email" autocomplete="email">
          <button type="submit" class="btn">{{ languages[lang].subscribe }}</button>
        </div>
      </form>
    </div>

    <div class="socials-list">
      <a href="https://www.facebook.com/veronique.deraedemaeker" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.instagram.com/veronique.deraedemaeker/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.youtube.com/@veroniquederaedemaeker" target="_blank" rel="noopener">YouTube</a>
    </div>
  </div>

</div>
